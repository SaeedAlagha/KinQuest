# Required for Gemini-powered family game content.
GEMINI_API_KEY=replace-with-a-server-side-key

# Production deploys require a valid Firebase ID token by default.
NODE_ENV=production
KINQUEST_REQUIRE_AUTH=true

# Comma-separated exact browser origins. Native apps do not send Origin.
KINQUEST_ALLOWED_ORIGINS=https://your-sila-app.example

# Per-IP API quota. Defaults to 60 requests every 60 seconds.
KINQUEST_RATE_LIMIT=60
KINQUEST_RATE_WINDOW_MS=60000

# Firebase Admin uses Application Default Credentials in production.
GOOGLE_CLOUD_PROJECT=kinquest-af379

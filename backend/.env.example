# Required for Gemini-powered family game content.
GEMINI_API_KEY=replace-with-a-server-side-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Required only for the Sila companion chat. The free router keeps the demo
# cost-free but still requires an OpenRouter API key.
OPENROUTER_API_KEY=replace-with-a-server-side-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://your-sila-app.example
OPENROUTER_APP_NAME=Sila

# Production deploys require a valid Firebase ID token by default.
NODE_ENV=production
KINQUEST_REQUIRE_AUTH=true

# Comma-separated exact browser origins. Native apps do not send Origin.
KINQUEST_ALLOWED_ORIGINS=https://your-sila-app.example

# Per-IP API quota. Defaults to 60 requests every 60 seconds.
KINQUEST_RATE_LIMIT=60
KINQUEST_RATE_WINDOW_MS=60000

# Additional per-user quota for OpenRouter-backed Sila chat messages.
# History and clear requests do not consume this generation quota.
KINQUEST_SILA_CHAT_RATE_LIMIT=10
KINQUEST_SILA_CHAT_RATE_WINDOW_MS=60000

# Firebase Admin uses Application Default Credentials in production.
GOOGLE_CLOUD_PROJECT=kinquest-af379

# Optional local alternative to the ignored firebase-service-account.json file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

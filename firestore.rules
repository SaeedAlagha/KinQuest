rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function family(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return signedIn()
        && currentUser().data.familyId == familyId
        && family(familyId).data.members.hasAny([request.auth.uid]);
    }

    function isFamilyOwner(familyId) {
      return isFamilyMember(familyId)
        && family(familyId).data.ownerId == request.auth.uid;
    }

    function isFamilyApprover(familyId) {
      return isFamilyOwner(familyId)
        || (
          isFamilyMember(familyId)
          && family(familyId).data.get('rewardApproverIds', [])
            .hasAny([request.auth.uid])
        );
    }

    function joinsFamilyWithOnlySelf() {
      return signedIn()
        && currentUser().data.familyId == null
        && !resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members']);
    }

    function leavesFamilyWithOnlySelf() {
      let oldApprovers = resource.data.get('rewardApproverIds', []);
      let newApprovers = request.resource.data.get('rewardApproverIds', []);

      return signedIn()
        && resource.data.ownerId != request.auth.uid
        && resource.data.members.hasAny([request.auth.uid])
        && !request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.hasOnly(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && newApprovers.hasOnly(oldApprovers)
        && !newApprovers.hasAny([request.auth.uid])
        && (
          (
            oldApprovers.hasAny([request.auth.uid])
            && newApprovers.size() == oldApprovers.size() - 1
          )
          || (
            !oldApprovers.hasAny([request.auth.uid])
            && newApprovers.size() == oldApprovers.size()
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'rewardApproverIds']);
    }

    function familyOwnerClearsMembership() {
      return signedIn()
        && resource.data.familyId != null
        && family(resource.data.familyId).data.ownerId == request.auth.uid
        && request.resource.data.familyId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'familyId',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.familyId == null
        && request.resource.data.tokens == 0
        && request.resource.data.rankingPoints == 0;

      allow read: if isSelf(userId)
        || (
          signedIn()
          && resource.data.familyId != null
          && resource.data.familyId == currentUser().data.familyId
        );

      allow update: if isSelf(userId)
        || familyOwnerClearsMembership()
        || (
          signedIn()
          && resource.data.familyId != null
          && resource.data.familyId == currentUser().data.familyId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tokens',
            'rankingPoints',
            'officialWins',
            'dailyWins',
            'weeklyWins',
            'monthlyWins',
            'gamesPlayed',
            'trophies',
            'missionsCompleted',
            'updatedAt'
          ])
        );

      allow delete: if isSelf(userId);

      match /tokenTransactions/{transactionId} {
        allow read: if isSelf(userId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/users/$(userId))
              .data.familyId == currentUser().data.familyId
          );
        allow create: if signedIn()
          && get(/databases/$(database)/documents/users/$(userId))
            .data.familyId == currentUser().data.familyId
          && request.resource.data.userId == userId
          && request.resource.data.familyId == currentUser().data.familyId;
        allow update, delete: if false;
      }

      match /ownedRewards/{rewardId} {
        allow read: if isSelf(userId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/users/$(userId))
              .data.familyId == currentUser().data.familyId
          );
        // Digital Reward ownership is written only by the trusted backend.
        allow create, update, delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isSelf(userId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/users/$(userId))
              .data.familyId == currentUser().data.familyId
          );
        // Equipped Digital Reward state is written only by the trusted backend.
        allow create, update, delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(userId);
        allow create: if signedIn()
          && request.resource.data.userId == userId
          && get(/databases/$(database)/documents/users/$(userId))
            .data.familyId == currentUser().data.familyId;
      }
    }

    match /families/{familyId} {
      // A family ID is also its invitation code, so direct reads support the
      // join flow. Collection listing remains restricted to family members.
      allow get: if signedIn();
      allow list: if isFamilyMember(familyId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members.size() == 1
        && request.resource.data.members.hasOnly([request.auth.uid]);
      allow update: if isFamilyOwner(familyId)
        || joinsFamilyWithOnlySelf()
        || leavesFamilyWithOnlySelf();
      allow delete: if isFamilyOwner(familyId);

      match /memories/{memoryId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyOwner(familyId);
      }

      match /rewardWishlist/{suggestionId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.suggestedBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      match /rewardWishlistProposals/{proposalId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.requesterId == request.auth.uid
          && get(
            /databases/$(database)/documents/users/$(request.resource.data.recipientId)
          ).data.familyId == familyId;
        allow update: if isFamilyMember(familyId)
          && (
            resource.data.requesterId == request.auth.uid
            || resource.data.recipientId == request.auth.uid
          );
        allow delete: if false;
      }

      match /rewardRequests/{requestId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.familyId == familyId;
        allow update: if isFamilyApprover(familyId)
          || (
            isFamilyMember(familyId)
            && resource.data.userId == request.auth.uid
          );
        allow delete: if false;
      }

      match /rewardRequestLocks/{lockId} {
        allow read, create, update, delete: if isFamilyMember(familyId);
      }

      match /rewardRedemptionLocks/{lockId} {
        allow read, create, update: if isFamilyMember(familyId);
        allow delete: if false;
      }

      match /missionBoards/{boardId} {
        allow read, create, update: if isFamilyMember(familyId);
        allow delete: if false;
      }

      match /missionCompletions/{completionId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.familyId == familyId
          && request.resource.data.proofRetained == false;
        allow update, delete: if false;
      }

      match /officialCompetitions/{competitionId} {
        allow read, create, update: if isFamilyMember(familyId);
        allow delete: if isFamilyOwner(familyId);
      }

      match /trophies/{trophyId} {
        allow read, create: if isFamilyMember(familyId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
